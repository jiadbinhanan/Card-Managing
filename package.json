{
  "name": "credics-monorepo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.26.1",
  "scripts": {
    "dev": "pnpm --filter @credics/web dev",
    "build": "pnpm --filter @credics/web build",
    "start": "pnpm --filter @credics/web start",
    "lint": "pnpm --filter @credics/web lint",
    "mobile": "pnpm --filter @credics/mobile start",
    "mobile:android": "pnpm --filter @credics/mobile android",
    "mobile:build": "pnpm --filter @credics/mobile build:android",
    "cap:sync": "pnpm --filter @credics/web cap:sync",
    "cap:open": "pnpm --filter @credics/web cap:open",
    "cap:build": "pnpm --filter @credics/web cap:build"
  }
}